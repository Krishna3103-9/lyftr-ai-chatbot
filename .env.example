# ---- LiteLLM key pool (at least TWO keys; key_1, key_2 in this order) -------
# Use "model|api_key" entries to spread the pool across models/providers, e.g.
# LLM_API_KEYS=gemini/gemini-2.0-flash|AAA,groq/llama-3.3-70b-versatile|BBB
LLM_API_KEYS=replace-with-key-1,replace-with-key-2
LLM_MODEL=gemini/gemini-2.0-flash
# Optional: OpenAI-compatible base URL for self-hosted / proxy endpoints
LLM_API_BASE=

# ---- Storage, CORS and test hook -------------------------------------------
# Docker uses /data (named volume). For bare-metal use sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a concise, helpful assistant.

# ---- LiteLLM built-in cache -----------------------------------------------
# local = in-memory, disk = on-disk under /data/llm_cache, none = disabled
LITELLM_CACHE_TYPE=local
LITELLM_CACHE_TTL_SECONDS=3600
LITELLM_CACHE_DIR=/data/llm_cache

# ---- Frontend build argument ----------------------------------------------
# Public backend URL baked into the React bundle at build time.
VITE_API_BASE_URL=http://localhost:8000
